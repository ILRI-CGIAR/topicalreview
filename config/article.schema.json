{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ILRI-CGIAR/topicalreview/blob/main/config/article.schema.json",
  "title": "CGIAR topical review article record v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "article_id",
    "file_name",
    "bibliographic",
    "bibliographic_provenance",
    "geography",
    "thematic_codes",
    "climate_hazards",
    "entities",
    "adaptation",
    "mitigation",
    "methods",
    "extraction_provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "article_id": {
      "type": "string",
      "minLength": 1
    },
    "file_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "bibliographic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authors",
        "year_published",
        "date_published",
        "title",
        "publication_type",
        "source",
        "volume",
        "issue",
        "start_page",
        "end_page",
        "pages",
        "doi",
        "abstract",
        "external_ids"
      ],
      "properties": {
        "authors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "first_name",
              "last_name",
              "display_name",
              "ids",
              "affiliations"
            ],
            "additionalProperties": false,
            "properties": {
              "first_name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "last_name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "display_name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "ids": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "type",
                    "value"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "type": "string",
                      "minLength": 1
                    },
                    "value": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "affiliations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "name_original",
                    "country_code",
                    "ids"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "name_original": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "country_code": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "ids": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "type",
                          "value"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "type": {
                            "type": "string",
                            "minLength": 1
                          },
                          "value": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "year_published": {
          "type": [
            "integer",
            "null"
          ]
        },
        "date_published": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "publication_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": "object",
          "required": [
            "title",
            "type",
            "publisher",
            "issn"
          ],
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": [
                "string",
                "null"
              ]
            },
            "publisher": {
              "type": [
                "string",
                "null"
              ]
            },
            "issn": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "volume": {
          "type": [
            "string",
            "null"
          ]
        },
        "issue": {
          "type": [
            "string",
            "null"
          ]
        },
        "start_page": {
          "type": [
            "string",
            "null"
          ]
        },
        "end_page": {
          "type": [
            "string",
            "null"
          ]
        },
        "pages": {
          "type": [
            "string",
            "null"
          ]
        },
        "doi": {
          "type": [
            "string",
            "null"
          ]
        },
        "abstract": {
          "type": [
            "string",
            "null"
          ]
        },
        "external_ids": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "value"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "bibliographic_provenance": {
      "type": "object",
      "required": [
        "primary_source",
        "sources",
        "last_verified"
      ],
      "additionalProperties": false,
      "properties": {
        "primary_source": {
          "type": [
            "string",
            "null"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "last_verified": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "geography": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "countries_iso3",
        "regions",
        "raw",
        "unparsed"
      ],
      "properties": {
        "countries_iso3": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          }
        },
        "regions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "raw": {
          "type": [
            "string",
            "null"
          ]
        },
        "unparsed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "thematic_codes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "level_1",
          "level_2",
          "level_3",
          "evidence"
        ],
        "properties": {
          "level_1": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "label"
            ],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "level_2": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "code",
                  "label"
                ],
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "level_3": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "code",
                  "label"
                ],
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "quote",
              "page"
            ],
            "properties": {
              "quote": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "page": {
                "type": [
                  "integer",
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "climate_hazards": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "entities": {
      "type": "object",
      "required": [
        "crops_species_raw",
        "organism_type"
      ],
      "additionalProperties": false,
      "properties": {
        "crops_species_raw": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "organism_type": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "adaptation": {
      "type": "object",
      "required": [
        "nature",
        "stage",
        "effectiveness",
        "finance",
        "mitigation_cobenefits"
      ],
      "additionalProperties": false,
      "properties": {
        "nature": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stage": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "effectiveness": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "finance": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "mitigation_cobenefits": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "mitigation": {
      "type": "object",
      "required": [
        "stage",
        "quantified",
        "adaptation_cobenefits"
      ],
      "additionalProperties": false,
      "properties": {
        "stage": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "quantified": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "adaptation_cobenefits": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "methods": {
      "type": "object",
      "required": [
        "purpose",
        "method_types",
        "time_scale",
        "spatial_scale",
        "data_source"
      ],
      "additionalProperties": false,
      "properties": {
        "purpose": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "method_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "time_scale": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "spatial_scale": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "data_source": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "extraction_provenance": {
      "type": "object",
      "required": [
        "extraction_id",
        "source_type",
        "model",
        "prompt_version",
        "ontology_version",
        "extracted_at",
        "review_status"
      ],
      "additionalProperties": false,
      "properties": {
        "extraction_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "prompt_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "ontology_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "extracted_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "review_status": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
